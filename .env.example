# При локальном запуске передайте переменные через окружение или node --env-file=.env.

# Режим сервера. Dockerfile задаёт production.
NODE_ENV=development

# Адрес прослушивания и локальный порт. Railway передаёт PORT сам.
HOST=0.0.0.0
PORT=3000

# Общий пароль для входа, обязателен в production.
APP_PASSWORD=

# Длинная случайная строка для подписи cookie. Без неё ключ меняется при перезапуске.
SESSION_SECRET=

# Локальная папка хранения. На Railway используется /data.
DATA_DIR=./data

# Максимальный размер загружаемого PDF в МБ.
MAX_UPLOAD_MB=25

# Срок хранения документов в днях.
RETENTION_DAYS=7

# Драйвер по умолчанию (mock или signotec). Читается при сборке фронтенда.
VITE_PAD_DRIVER=mock
